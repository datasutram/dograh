# =====================================================================
# Dograh configuration — read by docker-compose.yaml
# Blank / commented values fall back to the defaults shown.
# Apply changes by re-running the start script (docker compose restart
# does NOT pick up .env changes).
# =====================================================================

# ---- General ---------------------------------------------------------
ENVIRONMENT=local
ENABLE_TELEMETRY=TRUE
ENABLE_SIGNUP=true
FASTAPI_WORKERS=4
REGISTRY=dograhai

# Required: secret used to sign login tokens (auto-generated)
OSS_JWT_SECRET=f50448bdb4d7f1d279c8d7f6cda42f261df4e28979725419880b27efea06913d

# ---- Postgres --------------------------------------------------------
# Bundled container: 1 = run it, 0 = don't (use external DATABASE_URL below)
POSTGRES_REPLICAS=0
# Bundled container password. Comment this out when POSTGRES_REPLICAS=0,
# otherwise the start scripts try to sync it into the (absent) container.
POSTGRES_PASSWORD=postgres
# Full URL override — set to use an external Postgres (keep +asyncpg).
# Leave empty to use the bundled container.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ---- Redis -----------------------------------------------------------
# Bundled container: 1 = run it, 0 = don't (use external REDIS_URL below)
REDIS_REPLICAS=0
# Bundled container password (ignored when REDIS_URL is set)
REDIS_PASSWORD=redissecret
# Full URL override — set to use an external Redis (rediss:// for TLS).
# Leave empty to use the bundled container.
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=

# ---- Public endpoint (remote deployments) ----------------------------
SERVER_IP=
PUBLIC_HOST=
PUBLIC_BASE_URL=
BACKEND_API_ENDPOINT=

# ---- Object storage: MinIO (default) ---------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_ENDPOINT=

# ---- Object storage: AWS S3 / S3-compatible (optional) ---------------
ENABLE_AWS_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_SIGNATURE_VERSION=
S3_ADDRESSING_STYLE=

# ---- TURN / WebRTC ---------------------------------------------------
ENABLE_COTURN=false
TURN_HOST=
TURN_SECRET=
FORCE_TURN_RELAY=false

# ---- Cloudflare tunnel -----------------------------------------------
# Empty = ephemeral *.trycloudflare.com quick tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Telephony -------------------------------------------------------
TELEPHONY_WS_TOKEN_ENFORCE=false
TELEPHONY_WS_TOKEN_SECRET=

# ---- Background services ---------------------------------------------
ENABLE_ARI_MANAGER=true
ENABLE_CAMPAIGN_ORCHESTRATOR=true

# ---- Observability ---------------------------------------------------
ENABLE_PROMETHEUS_METRICS=false
DOGRAH_DEVOPS_SECRET=
LANGFUSE_TRACES_PUBLIC=false
